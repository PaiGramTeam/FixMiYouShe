<head>
    <meta charset="UTF-8">
    <title></title>
    <link rel="canonical" href="{{ post.url }}"/>
    <meta property="theme-color" content="#00a8fc"/>
    <meta property="twitter:site" content="{{ author.nickname }}"/>
    <meta property="twitter:creator" content="{{ author.nickname }}"/>
    <meta property="twitter:title" content="{{ post.subject }} ({{ author.nickname }})"/>
    <meta property="twitter:image" content="{{ post.cover }}"/>
    <meta property="twitter:card" content="summary_large_image"/>

    <meta property="og:url" content="{{ post.url }}"/>
    <meta property="og:image" content="{{ post.cover }}"/>
    <meta property="og:title" content="{{ post.subject }} ({{ author.nickname }})"/>
    <meta property="og:description" content="{{ description }}"/>
    {% set site_name = '森空岛' %}
    <meta property="og:site_name" content="{{ post.subject }} - {{ author.nickname }} - {{ site_name }}"/>

    <meta property="author" content="{{ author.nickname }}">
    <!-- Telegram -->
    <meta property="al:android:app_name" content="Medium"/>
    <meta property="article:published_time" content="{{ published_time }}"/>
    <meta name="telegram:channel" content="@{{ channel }}" />
</head>
<body>
<section class="section-backgroundImage">
    <figure class="graf--layoutFillWidth"></figure>
</section>
<section class="section--first">
    If you can see this, your browser is doing something weird with your user agent.
    <a href="{{ post.url }}">View original post</a>
</section>
<article>
    <!-- article content -->
    {{ article }}
    <!-- stat -->
    {{ stat }}
    <!-- topics -->
    {% if post.topics %}
    <p>
        {% for topic in post.topics %}
        <a href="{{ topic.url }}">#{{ topic.name }} </a>
        {% endfor %}
    </p>
    {% endif %}
    <p><a href="{{ post.url }}">{{ i18n.view }}</a></p>
    <!-- author -->
    <details>
        <summary>{{ i18n.author }}</summary>
        {% if author.avatar %}
        <img src="{{ author.avatar }}" alt="profile picture"/>
        {% endif %}
        <h2>{{ author.nickname }}</h2>
        <p>
            <a href="{{ author.url }}">@{{ author.nickname }}</a>
        </p>
    </details>
    <!-- related posts -->
    {% if related_posts %}
    {% for post_ in related_posts %}
    <related>
        {% if i18n.lang.value == 'zh-cn' %}{% set ends = '' %}{% else %}{% set ends = '/' + i18n.lang_alias %}{% endif %}
        <a href="https://{{ DOMAIN }}/{{ post.url_start }}{{ post_.post_id }}{{ ends }}">{{ post_.subject }}</a>
    </related>
    <br/>
    {% endfor %}
    {% endif %}
</article>
</body>
</html>
